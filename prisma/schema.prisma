generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TESTER
  PM
  ADMIN
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum VersionStatus {
  IN_PROGRESS
  RELEASED
  CANCELLED
}

enum TaskType {
  CHECKBOX
  TICKET_AGGREGATE
  INSTANCE_AGGREGATE
}

enum DeadlineType {
  FLEXIBLE
  DAYS_BEFORE_RELEASE
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

// Typ pola konfigurowalnej kolumny („kroku") w tabeli instancji. Na start tylko
// CHECKBOX; kolejne typy (TEXT, NUMBER, SELECT…) dojdą bez zmiany struktury.
enum ColumnFieldType {
  CHECKBOX
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  role               Role
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  theme              Theme    @default(SYSTEM)
  createdAt          DateTime @default(now())

  sessions              Session[]
  createdVersions       Version[]         @relation("CreatedVersions")
  statusChangedVersions Version[]         @relation("StatusChangedVersions")
  completedTasks        VersionTask[]     @relation("CompletedTasks")
  updatedTestRuns       InstanceTestRun[]  @relation("UpdatedTestRuns")
  updatedRunValues      InstanceRunValue[] @relation("UpdatedRunValues")
  comments              VersionComment[]   @relation("Comments")
  changeLogs            ChangeLog[]        @relation("ChangeLogs")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Version {
  id                String        @id @default(cuid())
  name              String        @unique
  releaseDate       DateTime      @db.Date
  status            VersionStatus @default(IN_PROGRESS)
  createdById       String
  statusChangedById String?
  statusChangedAt   DateTime?
  cancelReason      String?
  applicationId     String?
  createdAt         DateTime      @default(now())

  createdBy       User         @relation("CreatedVersions", fields: [createdById], references: [id], onDelete: Restrict)
  statusChangedBy User?        @relation("StatusChangedVersions", fields: [statusChangedById], references: [id], onDelete: Restrict)
  application     Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  tasks    VersionTask[]
  testRuns InstanceTestRun[]
  comments VersionComment[]
  columns  VersionColumn[]

  @@index([status, releaseDate])
  @@index([applicationId])
}

// Aplikacja = najprostszy podział wersji na produkty. Ikona (małe bajty)
// trzymana w bazie i serwowana read-only route handlerem. Zero hard delete —
// dezaktywacja przez isActive (jak Instance/TaskTemplate).
model Application {
  id            String    @id @default(cuid())
  name          String    @unique
  iconData      Bytes?
  iconType      String?
  iconUpdatedAt DateTime?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())

  versions Version[]
}

model TaskTemplate {
  id                String       @id @default(cuid())
  name              String
  description       String?
  taskType          TaskType
  deadlineType      DeadlineType
  daysBeforeRelease Int?
  sortOrder         Int
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())

  versionTasks VersionTask[]
}

model VersionTask {
  id             String     @id @default(cuid())
  versionId      String
  taskTemplateId String
  status         TaskStatus @default(NOT_STARTED)

  manualCounterCurrent Int @default(0)
  manualCounterTotal   Int @default(0)

  completedById String?
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  nameSnapshot              String?
  descriptionSnapshot       String?
  taskTypeSnapshot          TaskType?
  deadlineTypeSnapshot      DeadlineType?
  daysBeforeReleaseSnapshot Int?
  sortOrderSnapshot         Int?

  version      Version      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  taskTemplate TaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Restrict)
  completedBy  User?        @relation("CompletedTasks", fields: [completedById], references: [id], onDelete: Restrict)

  @@unique([versionId, taskTemplateId])
}

model Instance {
  id                 String   @id @default(cuid())
  name               String
  clientName         String?
  keyFunctionalities String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  testRuns InstanceTestRun[]
}

model InstanceTestRun {
  id         String @id @default(cuid())
  versionId  String
  instanceId String

  notes       String?
  excludedAt  DateTime?
  updatedAt   DateTime  @updatedAt
  updatedById String?

  version   Version            @relation(fields: [versionId], references: [id], onDelete: Cascade)
  instance  Instance           @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  updatedBy User?              @relation("UpdatedTestRuns", fields: [updatedById], references: [id], onDelete: Restrict)
  values    InstanceRunValue[]

  @@unique([versionId, instanceId])
  @@index([versionId, excludedAt])
}

// Katalog wielorazowych kolumn („kroków") tabeli instancji — konfiguracja admina.
// Wersje kopiują kroki przy podpięciu (VersionColumn, krok B), więc rename/dezaktywacja
// tutaj nie rusza istniejących wersji. Zero hard delete — dezaktywacja przez isActive.
model Column {
  id        String          @id @default(cuid())
  name      String
  fieldType ColumnFieldType @default(CHECKBOX)
  isActive  Boolean         @default(true)
  sortOrder Int
  createdAt DateTime        @default(now())

  templateItems  ColumnTemplateItem[]
  versionColumns VersionColumn[]
}

// Szablon („flow") — nazwany zestaw kroków. Jeden może być domyślny (isDefault):
// przy tworzeniu wersji jego kroki są podpinane (krok B).
model ColumnTemplate {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int
  createdAt DateTime @default(now())

  items ColumnTemplateItem[]
}

model ColumnTemplateItem {
  id         String @id @default(cuid())
  templateId String
  columnId   String
  sortOrder  Int

  template ColumnTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  column   Column         @relation(fields: [columnId], references: [id], onDelete: Restrict)

  @@unique([templateId, columnId])
}

// Zestaw kroków danej wersji — KOPIA przy podpięciu (name/fieldType kopiowane),
// więc rename/dezaktywacja w katalogu nie rusza istniejącej wersji. Usunięcie
// kroku z wersji = excludedAt (soft-hide, reguła 18) — wartości zostają.
model VersionColumn {
  id         String          @id @default(cuid())
  versionId  String
  columnId   String? // proweniencja (null = ad-hoc lub backfill historyczny)
  name       String
  fieldType  ColumnFieldType
  sortOrder  Int
  excludedAt DateTime?
  createdAt  DateTime        @default(now())

  version Version            @relation(fields: [versionId], references: [id], onDelete: Cascade)
  column  Column?            @relation(fields: [columnId], references: [id], onDelete: Restrict)
  values  InstanceRunValue[]

  @@index([versionId, excludedAt])
}

// Wartość jednego kroku dla jednego runu instancji. Wiersz na parę run×kolumna —
// zapis jednego pola niezależny od innych (reguła 21, brak wzajemnego nadpisywania).
// Brak wiersza = false (wartości tworzone leniwie przy pierwszym zaznaczeniu).
model InstanceRunValue {
  id              String   @id @default(cuid())
  testRunId       String
  versionColumnId String
  boolValue       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  updatedById     String?

  testRun       InstanceTestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  versionColumn VersionColumn   @relation(fields: [versionColumnId], references: [id], onDelete: Cascade)
  updatedBy     User?           @relation("UpdatedRunValues", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([testRunId, versionColumnId])
}

model VersionComment {
  id        String   @id @default(cuid())
  versionId String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  version Version @relation(fields: [versionId], references: [id], onDelete: Cascade)
  author  User    @relation("Comments", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([versionId, createdAt])
}

model ChangeLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  versionId  String?
  field      String
  oldValue   String?
  newValue   String?
  userId     String
  createdAt  DateTime @default(now())

  user User @relation("ChangeLogs", fields: [userId], references: [id], onDelete: Restrict)

  @@index([versionId, createdAt])
  @@index([entityType, entityId, field, createdAt])
}
