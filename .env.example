# Skopiuj do .env i uzupełnij realnymi wartościami: cp .env.example .env
# .env jest w .gitignore — nie commituj sekretów.

# --- Postgres (usługa `db` w docker-compose) ---
POSTGRES_USER=releasehub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=releasehub

# --- Baza dla aplikacji / Prisma ---
# Ta wartość (host localhost) jest używana lokalnie: `npx prisma migrate dev`,
# `npm run check`. W kontenerze docker-compose nadpisuje DATABASE_URL na host `db`.
DATABASE_URL=postgresql://releasehub:change-me@localhost:5432/releasehub?schema=public

# --- Sesje (używane od kroku 3a) ---
# Wygeneruj długi losowy ciąg, np.: openssl rand -hex 32
SESSION_SECRET=change-me-generate-a-long-random-string

# --- Flaga `secure` cookie ---
# Puste = `secure` w produkcji (wymaga HTTPS). Ustaw `false` wyłącznie, gdy aplikacja
# jest serwowana po zwykłym HTTP (bez reverse proxy z TLS) — inaczej logowanie się zapętla.
# Uwaga: wtedy cookie sesji idzie przez sieć otwartym tekstem.
COOKIE_SECURE=

# --- Jira Cloud (integracja read-only, od kroku J-1) ---
# Puste = integracja nieskonfigurowana (aplikacja działa normalnie).
# Token: id.atlassian.com → Security → API tokens. Zalecane konto serwisowe
# z uprawnieniem tylko do odczytu potrzebnych projektów.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
